# --- LLM Configuration ---
# Choose one provider: "deepseek", "openai", or "ollama"
LLM_PROVIDER=deepseek

# --- Provider-specific settings ---

# For DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
#DEEPSEEK_MODEL=deepseek-chat # Optional

# For OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
#OPENAI_MODEL=gpt-4-turbo # Optional

# For Ollama (https://ollama.com/)
# Make sure your local Ollama server is running and you have pulled the model.
# Example: ollama pull llama3
OLLAMA_MODEL=llama3
#OLLAMA_API_URL=http://localhost:11434/api/chat # Optional, default for local Ollama
